# AUTO PULSE — Environment Configuration

# Optional External Car Imagery / Telemetry API Keys
# If not provided, AUTO PULSE seamlessly connects to live high-resolution automotive imagery services with Wikimedia Commons, Car Imagery CDNs, NHTSA Vehicle API, and verified OEM fallbacks.
# VITE_CAR_IMAGERY_API_KEY=your_api_key_here
# VITE_CAR_IMAGERY_API_URL=https://api.carmarketplace.com/v1/images

# Optional External Weather API (e.g. OpenWeatherMap)
# If not set, AUTO PULSE uses the high-precision Open-Meteo Weather API with zero authentication requirement and full WMO code mapping.
# VITE_WEATHER_API_KEY=your_weather_api_key
# VITE_WEATHER_API_URL=https://api.openweathermap.org/data/2.5/weather

# Optional External Google Places / Workshop Discovery API
# If not set, AUTO PULSE uses localized calibrated workshop coordinates with live Haversine distance calculations from the user's detected location.
# VITE_PLACES_API_KEY=your_places_api_key
# VITE_PLACES_API_URL=https://maps.googleapis.com/maps/api/place/nearbysearch/json

# Optional External Connected Vehicle / CAN-Bus Telemetry API
# If not set, AUTO PULSE uses its automotive diagnostic health intelligence engine calibrated to vehicle powertrain, maintenance records, and sensor thresholds.
# VITE_VEHICLE_TELEMETRY_API_KEY=your_telemetry_key
# VITE_VEHICLE_TELEMETRY_API_URL=https://api.connectedcar.io/v1/telemetry
