# AUTO PULSE — Environment Configuration

# External Vehicle Image API (Optional External Car Image Provider / Car Imagery CDN / Wikimedia / Unsplash)
# When set, AUTO PULSE queries this endpoint with vehicle make + model.
# If unset or if the API returns no match, AUTO PULSE seamlessly resolves verified exact OEM images and cached assets.
VITE_VEHICLE_IMAGE_API_URL=https://en.wikipedia.org/w/api.php
VITE_VEHICLE_IMAGE_API_KEY=

# Weather & Telemetry Configurations
VITE_WEATHER_API_URL=https://api.open-meteo.com/v1/forecast
